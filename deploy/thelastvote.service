[Unit]
Description=The Last Vote game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/arcosium/projects/thelastvote
EnvironmentFile=/home/arcosium/vault/thelastvote/.env
Environment=NODE_ENV=production
Environment=TRUST_CLOUDFLARE=1
ExecStart=/home/arcosium/.nvm/versions/node/v24.18.0/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
UMask=0077
MemoryMax=2G

[Install]
WantedBy=default.target
